# local | hosted | enterprise
SEED_REFLECTIONS_MODE=local
SEED_REFLECTIONS_HOST=127.0.0.1
SEED_REFLECTIONS_PORT=8476
SEED_REFLECTIONS_DATA_DIR=./data
SEED_REFLECTIONS_UPLOAD_JOBS_DIR=./data/uploads/jobs
# Use 0 for new deployments; use 1 only when intentionally migrating seeds.json once.
SEED_REFLECTIONS_MIGRATE_LEGACY=0

# Required for hosted/enterprise. Never use * outside local mode.
SEED_REFLECTIONS_PUBLIC_ORIGIN=https://seed-reflections.example.com
# Public DNS name only; used by docker-compose.prod.yml and Caddy.
SEED_REFLECTIONS_DOMAIN=seed-reflections.example.com
SEED_REFLECTIONS_PROXY_MAX_BODY=2GB

# Resource and abuse boundaries
SEED_REFLECTIONS_MAX_UPLOAD_BYTES=2147483648
SEED_REFLECTIONS_HOSTED_STORAGE_BYTES=10737418240
SEED_REFLECTIONS_HOSTED_MAX_CONVERSATIONS=1000000
SEED_REFLECTIONS_HOSTED_MAX_ANALYSIS_JOBS=10000
SEED_REFLECTIONS_AUTH_RATE_LIMIT=10
SEED_REFLECTIONS_AUTH_RATE_WINDOW_SECONDS=60

# Dormant switches
SEED_REFLECTIONS_BILLING_ENABLED=0
SEED_REFLECTIONS_EXTERNAL_AI_ENABLED=0
SEED_REFLECTIONS_TEAM_ENABLED=0
