  "narrative": {
    "northStar": "The Dark Console",
    "overview": "A GitHub-dark workbench: a near-black page, slightly lighter cards, thin borders and a single green that says 'do this'. Headlines are heavy and tight Inter, with a green-to-teal gradient on the second half of the hero line. Every page, public and app, uses the same palette, type and green.",
    "keyCharacteristics": [
      "Near-black ground with tonal layering instead of shadows",
      "Inter 900 display type, tight tracking",
      "One green (#3fb950) for the action that matters, with black text on it",
      "Identical two-row header and five nav items on every public page",
      "App pages share the same palette in a left-rail layout"
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Green marks the single action or the selected state on a screen. A second action uses the outline style.",
        "section": "colors"
      },
      {
        "name": "The Black-On-Green Rule",
        "body": "Text on #3fb950 is black. White on this green is about 2.3:1.",
        "section": "colors"
      },
      {
        "name": "The One System Rule",
        "body": "No page gets its own palette. The dashboard and the local product page used to; both now use this system.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do put black text on green",
      "Do keep one green action per view",
      "Do use the shared header on every public page",
      "Do keep claims to what is built"
    ],
    "donts": [
      "Don't recolour a page to a private palette",
      "Don't use a serif for headings or a blue primary button",
      "Don't use white text on #3fb950",
      "Don't use the plant icon in navigation or UI chrome"
    ]
  }
